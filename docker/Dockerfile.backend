# syntax=docker/dockerfile:1
# ----------------------------------------
# Stage 1: Build sick_scan_xd C++ library
# ----------------------------------------
FROM ubuntu:22.04 AS backend-builder

ENV ROS_VERSION=0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
  git \
  build-essential \
  cmake \
  gdb \
  ninja-build \
  && rm -rf /var/lib/apt/lists/*

RUN git clone -b 3.9.0 https://github.com/SICKAG/sick_scan_xd.git /workspace/sick_scan_xd \
  && mkdir -p /workspace/build \
  && cd /workspace/build \
  && rm -rf ./* \
  && export ROS_VERSION=0 \
  && cmake -DROS_VERSION=0 -DLDMRS=0 -G "Unix Makefiles" ../sick_scan_xd \
  && make -j4

# ----------------------------------------
# Stage 2: Python runtime (no Angular)
# ----------------------------------------
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
  libegl1 \
  libgl1 \
  libgomp1 \
  && rm -rf /var/lib/apt/lists/* \
  && rm -rf /usr/lib/x86_64-linux-gnu/dri/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --compile-bytecode \
  && find /app/.venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true \
  && rm -rf /app/.venv/lib/python3.12/site-packages/open3d/resources \
  && rm -rf /app/.venv/lib/python3.12/site-packages/open3d/examples \
  && rm -rf /app/.venv/lib/python3.12/site-packages/open3d/labextension \
  && rm -rf /app/.venv/lib/python3.12/site-packages/open3d/nbextension \
  && find /app/.venv -type d -name "tests" -exec rm -rf {} + 2>/dev/null || true \
  && find /app/.venv -type d -name "test" -exec rm -rf {} + 2>/dev/null || true

COPY --from=backend-builder \
  /workspace/build/libsick_scan_xd_shared_lib.so \
  /workspace/build/sick_generic_caller \
  ./build/
COPY --from=backend-builder /workspace/sick_scan_xd/launch/ ./launch/
RUN rm -f ./launch/test_*

COPY main.py .
COPY app/ ./app/
# Empty static dir keeps app.frontend() happy at startup; nginx serves the UI.
RUN mkdir -p ./app/static

EXPOSE 8005
CMD ["uv", "run", "--no-sync", "python", "main.py"]
